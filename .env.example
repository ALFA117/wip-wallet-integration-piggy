# Copia este archivo a `.env` y rellena los valores.
#
#   cp .env.example .env
#   npm install
#   npx prisma db push
#   npm run dev

# ---------------------------------------------------------------------------
# Base de datos (Postgres — probado sobre Supabase)
# Connect > ORMs > Prisma. Son dos: el pooler para la app, la directa para DDL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# Autenticación (Auth.js con Google)
#
# Google Cloud Console > APIs y servicios > Credenciales >
# Crear credenciales > ID de cliente de OAuth 2.0 > Aplicación web.
#
# URI de redirección autorizados:
#   http://localhost:3020/api/auth/callback/google
#   https://TU-APP.vercel.app/api/auth/callback/google
#
# AUTH_SECRET: genera uno con `npx auth secret` o cualquier cadena aleatoria.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Billetera del agente — SDK en proceso (@tetherto/wdk-wallet-evm)
#
# De esta seed maestra se derivan TODAS las tesorerías: el índice 0 es la cuenta
# que reparte fondos de prueba, y cada usuario recibe su propio hueco de
# índices. No se guarda ninguna frase semilla en la base de datos, solo números.
#
# Genera una con: npx wdk wallet create --name loquesea
# Úsala SOLO en testnet. Nunca una billetera con dinero real.
# ---------------------------------------------------------------------------
MASTER_SEED=""
EVM_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Contrato del token que mueve la demo, y sus decimales.
TOKEN_ADDRESS=""
TOKEN_DECIMALS="6"
EXPLORER_BASE="https://sepolia.etherscan.io/tx/"

# ---------------------------------------------------------------------------
# WDK CLI — solo para el flujo local (lib/wdk.ts)
# El despliegue usa el SDK; el CLI necesita un binario que no existe en
# serverless. Ambos son WDK oficial.
# ---------------------------------------------------------------------------
WDK_CLI_BIN=""
WDK_NETWORK="sepolia"
WDK_WALLET_NAME="wip-treasury"
WDK_TOKEN="testusdt"
WDK_TREASURY_ADDRESS=""
WDK_DRY_RUN="0"

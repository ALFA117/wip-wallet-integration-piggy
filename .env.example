# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
#
# Después:
#   npm install
#   npx prisma generate
#   npx prisma db push
#   npm run seed
#   npm run dev

# ---------------------------------------------------------------------------
# Base de datos (Postgres — probado sobre Supabase)
# Supabase: Settings > Database > Connection string > URI
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase (opcional; solo si consultas desde el cliente)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# WDK CLI — @tetherto/wdk-cli 1.0.0-beta.3
# Billetera DEDICADA de testnet con fondos mínimos. Nunca una personal.
# ---------------------------------------------------------------------------
WDK_CLI_BIN="wdk"              # binario o ruta al CLI
WDK_NETWORK="sepolia"
WDK_WALLET_NAME="wip-treasury"
WDK_WALLET_PASSWORD=""         # password de la billetera del CLI
WDK_TREASURY_ADDRESS=""        # dirección del agente (salida de `wdk wallet create`)
WDK_USDT_CONTRACT=""           # contrato USD₮ en Sepolia — verificado, NUNCA inventado
WDK_USDT_DECIMALS="6"

# "1" = balance e historial simulados, sin CLI. Para desarrollo de UI únicamente.
# Déjalo en "0" para la demo: el txHash tiene que existir en Sepolia.
WDK_DRY_RUN="0"

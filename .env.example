# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
#
# Después:
#   npm install
#   npx prisma generate
#   npx prisma db push
#   npm run seed
#   npm run dev

# ---------------------------------------------------------------------------
# Base de datos (Postgres — probado sobre Supabase)
# Supabase: Settings > Database > Connection string > URI
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase (opcional; solo si consultas desde el cliente)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# WDK CLI — @tetherto/wdk-cli 1.0.0-beta.3
#
# Billetera DEDICADA de testnet con fondos mínimos. Nunca una personal.
#
#   npx wdk wallet create --name wip-treasury
#   npx wdk wallet unlock --name wip-treasury --ttl 0
#   npx wdk get address --network sepolia --wallet wip-treasury --json
#
# La passphrase NO va en este archivo. El CLI la pide por consola al desbloquear
# y guarda la sesión en un daemon; el código nunca la ve.
# ---------------------------------------------------------------------------

# Vacío = usa el binario de node_modules/.bin. Ponlo solo si el CLI está en otro sitio.
WDK_CLI_BIN=""
WDK_NETWORK="sepolia"
WDK_WALLET_NAME="wip-treasury"

# Nombre del token en el registro del CLI, NO una dirección de contrato.
# En Sepolia, `usdt` viene registrado de fábrica y apunta a
# 0xd077A400968890Eacc75cdc901F0356c943e4fDb (6 decimales).
# Verifícalo con: npx wdk token info --network sepolia --token usdt --json
WDK_TOKEN="usdt"

# Dirección del agente (salida de `wdk get address`).
WDK_TREASURY_ADDRESS=""

# "1" = balance simulado y transferencias deshabilitadas, para desarrollar la
# interfaz sin billetera. Déjalo en "0" para la demo: el txHash tiene que
# existir en Sepolia.
WDK_DRY_RUN="0"

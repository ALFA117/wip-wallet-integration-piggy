// WIP — Wallet Integration Piggy
// La alcancía compartida del grupo, con un guardián que no se puede sobornar.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cuentas
// ---------------------------------------------------------------------------

/// Quien inicia sesión. El `id` es el DID que emite Privy (`did:privy:…`), no
/// un identificador nuestro: es estable aunque la persona cambie de método de
/// acceso, así que quien entra hoy con Google y mañana con una billetera sigue
/// siendo dueño de la misma alcancía.
///
/// La sesión la gestiona Privy; aquí no se guardan tokens ni contraseñas.
model User {
  id    String  @id
  name  String?
  email String?
  image String?

  /// Índice BIP-44 del que se deriva su tesorería a partir de la seed maestra.
  /// No es un secreto: la seed no se guarda en ninguna parte, solo este número.
  walletIndex Int? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treasuries Treasury[]

  @@index([email])
}

// ---------------------------------------------------------------------------
// El producto
// ---------------------------------------------------------------------------

/// Integrante de una alcancía. No inicia sesión: es una fila del escenario, y
/// el selector de la barra superior cambia entre ellas para probar el flujo de
/// varias firmas sin coordinar a nadie.
model Member {
  id            String   @id @default(cuid())
  treasuryId    String
  treasury      Treasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  email         String
  name          String
  role          String // 'ADMIN' | 'MEMBER'
  walletAddress String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requested Payment[]  @relation("RequestedBy")
  approvals Approval[]

  @@unique([treasuryId, email])
  @@index([treasuryId])
}

/// La alcancía. Su dirección se deriva de la seed maestra con el índice de su
/// dueño, así que el agente firma sin que nadie custodie una seed por usuario.
model Treasury {
  id            String   @id @default(cuid())
  name          String
  walletAddress String   @unique
  walletIndex   Int
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rules    Rule?
  members  Member[]
  payments Payment[]

  @@index([ownerId])
}

/// El reglamento que el grupo define por adelantado.
model Rule {
  id         String   @id @default(cuid())
  treasuryId String   @unique
  treasury   Treasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)

  autoApproveUnder Float
  requireApprovals Int
  adminOnlyOver    Float
  monthlyBudget    Float
  dailyLimit       Float
  maxSingleTx      Float
  allowlistCsv     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Una solicitud de pago y su rastro de auditoría completo.
model Payment {
  id            String   @id @default(cuid())
  treasuryId    String
  treasury      Treasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   Member   @relation("RequestedBy", fields: [requestedById], references: [id])

  toEmail    String
  toAddress  String
  amount     Float
  reason     String
  rawRequest String

  status       String // PENDING_APPROVAL | APPROVED | EXECUTING | SUCCESS | FAILED | REJECTED
  decisionPath String // AUTO | MULTI_SIG | ADMIN_ONLY | REJECTED
  decisionLog  String // JSON del array de chequeos
  rejectReason String?

  txHash       String?   @unique
  errorMessage String?
  executedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  approvals Approval[]

  @@index([treasuryId, status])
  @@index([treasuryId, createdAt])
}

/// Un voto sobre un pago pendiente. Un solo veto lo manda a REJECTED.
model Approval {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  approverId String
  approver   Member   @relation(fields: [approverId], references: [id])
  approved   Boolean
  createdAt  DateTime @default(now())

  @@unique([paymentId, approverId])
  @@index([approverId])
}

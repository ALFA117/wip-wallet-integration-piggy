# Privy y viem piden versiones incompatibles de la misma dependencia
# transitiva (`ox`, y `@stripe/stripe-js` por debajo de `@stripe/crypto`).
# Ambas funcionan juntas en la práctica; lo que no funciona es el resolutor
# estricto de npm. Sin esto, el despliegue falla en `npm install`.
legacy-peer-deps=true
